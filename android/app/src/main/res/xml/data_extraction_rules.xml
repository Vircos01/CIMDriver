<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Privacy-first: Cloud back-up uitsluiten voor gevoelige locatie- en rittendata in Room en fotobewijs -->
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="photos" />
    </cloud-backup>
    <!-- Lokale apparaat-naar-apparaat overdracht (kabel of directe wifi bij toestelwissel) expliciet toestaan -->
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="photos" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
